# Variables de entorno para el proyecto NAO

# ============ GOOGLE VERTEX AI ============
# ID del proyecto de Google Cloud Platform
GCP_PROJECT_ID=tu-proyecto-gcp-id
# Región de Vertex AI (us-central1, us-east1, europe-west1, etc.)
GCP_LOCATION=us-central1

# ============ TELEGRAM BOT ============
TELEGRAM_BOT_TOKEN=tu_bot_token_de_telegram_aqui

# ============ GOOGLE CALENDAR API ============
GOOGLE_CALENDAR_CREDENTIALS_FILE=credentials.json
GOOGLE_CALENDAR_TOKEN_FILE=token.json
GOOGLE_CALENDAR_ID=primary

# ============ SERPER API (Web Search) ============
# Para habilitar búsqueda web en el agente
# Obtén tu API Key gratis en: https://serper.dev (2500 búsquedas gratis)
SERPER_API_KEY=tu_serper_api_key_aqui

# ============ GOOGLE TASKS API ============
# Usa el mismo credentials.json y token.json que Calendar
# Solo necesitas habilitar Google Tasks API en Google Cloud Console
GOOGLE_TASKS_LIST_ID=@default

# ============ GOOGLE KEEP (No oficial) ============
# Google Keep NO tiene API oficial. Usamos gkeepapi (biblioteca no oficial)
# IMPORTANTE: Debes generar una "Contraseña de aplicación" (App Password)
# Pasos:
# 1. Habilita la verificación en 2 pasos en tu cuenta de Google
# 2. Ve a: https://myaccount.google.com/apppasswords
# 3. Genera una contraseña para "Otra aplicación personalizada"
# 4. Usa esa contraseña aquí (NO tu contraseña normal de Google)
GOOGLE_KEEP_EMAIL=tu_email@gmail.com
GOOGLE_KEEP_APP_PASSWORD=tu_app_password_de_16_caracteres
