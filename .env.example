# Variables de entorno para el proyecto NAO

# ============ GOOGLE GEMINI API ============
GOOGLE_GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# ============ TELEGRAM BOT ============
TELEGRAM_BOT_TOKEN=tu_bot_token_de_telegram_aqui

# ============ GOOGLE CALENDAR API ============
GOOGLE_CALENDAR_CREDENTIALS_FILE=credentials.json
GOOGLE_CALENDAR_TOKEN_FILE=token.json
GOOGLE_CALENDAR_ID=primary

# ============ SERPER API (Web Search) ============
# Para habilitar búsqueda web en el agente
# Obtén tu API Key gratis en: https://serper.dev (2500 búsquedas gratis)
SERPER_API_KEY=tu_serper_api_key_aqui

# ============ GOOGLE TASKS API ============
# Usa el mismo credentials.json y token.json que Calendar
# Solo necesitas habilitar Google Tasks API en Google Cloud Console
GOOGLE_TASKS_LIST_ID=@default
